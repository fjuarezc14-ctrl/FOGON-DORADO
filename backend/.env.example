# ================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — FOGÓN DORADO
# ================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como: .env
#    cp .env.example .env
# 2. Rellena cada valor con las credenciales reales
# 3. NUNCA subas el archivo .env a GitHub
# ================================================================

# --- Base de Datos PostgreSQL ---
DATABASE_URL="postgresql://fogon_user:fogon_password@db:5432/fogon_dorado"
PORT=3000

# --- API Consulta DNI/RUC (APIsNetPe / Decolecta) ---
# Obtener en: https://apis.net.pe
APIS_NET_PE_TOKEN="tu_token_aqui"

# --- Facturación Electrónica (Nubefact) ---
# Obtener en: https://nubefact.com → Panel → API
NUBEFACT_API_URL="https://api.nubefact.com/api/v1/TU_RUC_AQUI"
NUBEFACT_TOKEN="tu_token_nubefact_aqui"

# --- Simulador de caída Nubefact (solo para pruebas) ---
# Cambiar a true para simular que Nubefact está caído
NUBEFACT_SIMULATE_OUTAGE=false
