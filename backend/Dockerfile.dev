FROM node:20-alpine

WORKDIR /app

# Instalar dependencias del sistema para Prisma
RUN apk add --no-cache openssl

COPY package.json ./
RUN npm install

# Copiar el schema de Prisma y generar el cliente
COPY prisma ./prisma
RUN npx prisma generate

COPY . .

EXPOSE 3000

# Al iniciar: migrar BD, cargar datos iniciales y luego arrancar servidor
CMD ["sh", "-c", "npx prisma migrate deploy && node prisma/seed.js && node server.js"]
